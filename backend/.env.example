# PostgreSQL connection (Railway gives you this as DATABASE_URL directly — paste it as-is)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Server
PORT=4000

# Email (Brevo SMTP relay — check your Brevo account for these values;
# Nodemailer works with any SMTP provider, so swap these for another provider if you prefer)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM="LabTrace <reports@yourdomain.example>"
